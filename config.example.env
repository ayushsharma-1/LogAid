# LogAid Configuration Examples
# This file contains various configuration examples for different use cases

# =============================================================================
# Basic Configuration (Recommended for most users)
# =============================================================================

# AI Provider: Use Gemini for fast and cost-effective analysis
LOGAID_AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LOGAID_AI_MODEL=gemini-1.5-flash
LOGAID_MAX_TOKENS=1000
LOGAID_TEMPERATURE=0.3

# Enable features for best experience
LOGAID_ENABLE_COLORS=true
LOGAID_ENABLE_LOGGING=true
LOGAID_ENABLE_LOCAL_FALLBACK=false

# =============================================================================
# Privacy-First Configuration (For sensitive environments)
# =============================================================================

# Use local AI models for complete privacy
# LOGAID_AI_PROVIDER=local
# LOGAID_LOCAL_MODEL_PATH=/path/to/local/model
# LOGAID_ENABLE_LOCAL_FALLBACK=true
# LOGAID_ENABLE_LOGGING=false  # Disable logging for maximum privacy

# =============================================================================
# Power User Configuration (Maximum features)
# =============================================================================

# OpenAI for complex reasoning
# LOGAID_AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# LOGAID_AI_MODEL=gpt-4
# LOGAID_MAX_TOKENS=2000
# LOGAID_TEMPERATURE=0.2

# Advanced logging
# LOGAID_LOG_LEVEL=debug
# LOGAID_LOG_PATH=~/.logaid/logs/detailed.json
# LOGAID_ENABLE_ANALYTICS=true

# All plugins enabled
# LOGAID_ENABLED_PLUGINS=apt,git,npm,docker,kubernetes,terraform,ansible,generic

# =============================================================================
# Development Configuration (For LogAid development)
# =============================================================================

# Development settings
# LOGAID_AI_PROVIDER=gemini
# LOGAID_LOG_LEVEL=debug
# LOGAID_ENABLE_DEBUG_MODE=true
# LOGAID_PROMPT_TIMEOUT=60  # Longer timeout for debugging

# =============================================================================
# Team Configuration (For shared environments)
# =============================================================================

# Shared API key management (use environment-specific keys)
# LOGAID_AI_PROVIDER=gemini
# LOGAID_API_KEY=${TEAM_GEMINI_API_KEY}
# LOGAID_AI_MODEL=gemini-1.5-pro
# LOGAID_MAX_TOKENS=1500

# Team-specific plugins
# LOGAID_ENABLED_PLUGINS=git,docker,kubernetes,terraform
# LOGAID_PLUGIN_DIR=/shared/logaid/plugins

# =============================================================================
# Security-Focused Configuration
# =============================================================================

# Minimal permissions and restricted features
# LOGAID_AI_PROVIDER=gemini
# LOGAID_ENABLE_LOCAL_FALLBACK=true
# LOGAID_ENABLE_LOGGING=false
# LOGAID_PROMPT_TIMEOUT=10  # Quick timeout
# LOGAID_ENABLED_PLUGINS=git,npm  # Only essential plugins

# =============================================================================
# Performance-Optimized Configuration
# =============================================================================

# Fast responses with minimal processing
# LOGAID_AI_PROVIDER=gemini
# LOGAID_AI_MODEL=gemini-1.5-flash
# LOGAID_MAX_TOKENS=500
# LOGAID_TEMPERATURE=0.1
# LOGAID_PROMPT_TIMEOUT=5
# LOGAID_ENABLE_CACHING=true

# =============================================================================
# Multi-Provider Configuration (Fallback setup)
# =============================================================================

# Primary provider
# LOGAID_AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key

# Fallback provider
# LOGAID_FALLBACK_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key

# Local fallback for ultimate reliability
# LOGAID_ENABLE_LOCAL_FALLBACK=true

# =============================================================================
# Shell-Specific Configurations
# =============================================================================

# Bash configuration
# LOGAID_SHELL=/bin/bash
# LOGAID_BASH_COMPLETION=true

# Zsh configuration
# LOGAID_SHELL=/bin/zsh
# LOGAID_ZSH_INTEGRATION=true

# Fish configuration
# LOGAID_SHELL=/usr/bin/fish
# LOGAID_FISH_INTEGRATION=true

# =============================================================================
# Plugin-Specific Configurations
# =============================================================================

# Docker plugin settings
# LOGAID_DOCKER_REGISTRY=your-registry.com
# LOGAID_DOCKER_NAMESPACE=your-namespace

# Kubernetes plugin settings
# LOGAID_K8S_NAMESPACE=default
# LOGAID_K8S_CONTEXT=your-context

# Git plugin settings
# LOGAID_GIT_DEFAULT_BRANCH=main
# LOGAID_GIT_REMOTE=origin

# NPM plugin settings
# LOGAID_NPM_REGISTRY=https://registry.npmjs.org/

# =============================================================================
# Environment-Specific Configurations
# =============================================================================

# Development environment
# LOGAID_ENV=development
# LOGAID_LOG_LEVEL=debug
# LOGAID_ENABLE_COLORS=true

# Production environment
# LOGAID_ENV=production
# LOGAID_LOG_LEVEL=error
# LOGAID_ENABLE_LOGGING=true
# LOGAID_ENABLE_COLORS=false

# CI/CD environment
# LOGAID_ENV=ci
# LOGAID_ENABLE_COLORS=false
# LOGAID_PROMPT_TIMEOUT=30
# LOGAID_BATCH_MODE=true
