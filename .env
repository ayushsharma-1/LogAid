# LogAid Configuration
# Copy this file to .env and configure as needed

# AI Configuration
LOGAID_AI_PROVIDER=gemini
LOGAID_API_KEY=AIzaSyAkA_IdOZZCiT9NQ85ccmzVKMU-jB2-QTc
LOGAID_AI_MODEL=gemini-1.5-flash
LOGAID_MAX_TOKENS=1000
LOGAID_TEMPERATURE=0.3

# Logging Configuration
LOGAID_LOG_LEVEL=info
LOGAID_LOG_PATH=~/.logaid/logs/history.json

# Plugin Configuration
LOGAID_PLUGIN_DIR=~/.logaid/plugins
LOGAID_ENABLED_PLUGINS=apt,git,npm,docker,kubernetes,generic

# Terminal Configuration
LOGAID_SHELL=/bin/bash
LOGAID_PROMPT_TIMEOUT=30

# Feature Flags
LOGAID_ENABLE_LOCAL_FALLBACK=false
LOGAID_ENABLE_LOGGING=true
LOGAID_ENABLE_COLORS=true

# API Keys
GEMINI_API_KEY=AIzaSyAkA_IdOZZCiT9NQ85ccmzVKMU-jB2-QTc
OPENAI_API_KEY=sk-proj-65wl5QEP4_j1JINr3RcFm7SJRKFbGcm33aOqKRGwVhjHV5A_9veBxd6y6cZYBkHN2DLAqJOx4T_BlbkFJ

# Security & Sanitization Configuration
ENABLE_SECURITY_SANITIZATION=true
AUTO_SANITIZE_FOR_AI=true
REQUIRE_CONSENT_FOR_AI=true
REQUIRE_CONSENT_FOR_SENSITIVE=true
MAX_RISK_LEVEL_FOR_AI=Medium
BLOCK_HIGH_RISK_COMMANDS=true
LOG_SECURITY_EVENTS=true
DANGEROUS_COMMANDS_CHECK=true